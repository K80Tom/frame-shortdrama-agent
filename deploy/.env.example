# Lyra 一键部署配置模板：复制为 .env 后填写。
#   cp .env.example .env
# PostgreSQL 管理/应用密码、Redis、MinIO root/应用凭据为必填；模型连接可在启动后配置。
# 注意：本文件只供本机 Docker Compose 使用，不要提交真实的 key 或密码。

# ---- 会话与公开 Origin ----
# Compose 强制使用 session 认证；正式上线必须换成用户看到的 HTTPS Origin。
LYRA_PUBLIC_ORIGIN=http://localhost:8788
LYRA_SESSION_TTL_SECONDS=604800
# 自助注册默认关闭。仅在受信、自托管环境中设为 workspace；每位注册者会创建
# 独立 workspace 并成为该 workspace 的 owner。不要预置或公开默认密码。
# 公网开放前还需完成邮箱验证、CAPTCHA/WAF 防滥用和租户额度/计费控制。
LYRA_REGISTRATION_MODE=disabled
# 通常留空以使用 host-only Cookie；只有明确需要跨子域时才设置。
LYRA_COOKIE_DOMAIN=

# ---- Lyra 全局视觉背景（公开展示资源，不得填写密钥）----
# 只接受 HTTPS URL；Web 容器启动时写入 runtime-config.js，替换素材无需重建镜像。
# 建议把已获授权的 MP4/WebP 放在自有 OSS/COS/S3 + CDN，留空则使用 CSS 金紫极光降级层。
LYRA_BACKDROP_VIDEO_URL=
LYRA_BACKDROP_POSTER_URL=

# ---- PostgreSQL 管理迁移账号（只给 postgres / postgres-app-role / migrate）----
POSTGRES_USER=shortdrama
POSTGRES_DB=shortdrama_agent
# 必填：强随机且不要与应用密码相同；建议只用字母与数字（密码会拼进管理 DSN）。
POSTGRES_PASSWORD=

# ---- PostgreSQL 非特权应用账号（只给 main-api / main-worker）----
# 仅使用小写字母、数字、下划线；Compose 会幂等创建为 NOSUPERUSER、NOCREATEDB、NOCREATEROLE、NOBYPASSRLS。
POSTGRES_APP_USER=lyra_app
# 必填：必须与 POSTGRES_PASSWORD 不同；建议只用字母与数字（密码会拼进应用 DSN）。
POSTGRES_APP_PASSWORD=

# ---- Redis（对话快照 + 登录/API 分布式限流；SSE fan-out 尚未接入）----
# 限流依赖故障时会失败关闭；建议密码只使用字母和数字。
REDIS_PASSWORD=
# 热上下文过期时间（秒）；完整消息仍以 PostgreSQL 为准。
CONVERSATION_CONTEXT_TTL_SECONDS=1800

# ---- 初版自托管对象存储（MinIO）----
# root 凭据只给 MinIO 初始化与 Milvus 内部对象桶使用。
# Compose 会探测 lyra-media bucket；探针成功不代表历史生产媒体已完成对象投影。
# `/api/production-media/:id/access` 已提供短期签名入口，但签名 URL 中的 endpoint 必须是
# 浏览器/上游模型能访问的公网 HTTPS 地址；容器内部的 `http://minio:9000` 不等于公网可达。
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# 应用使用单独的最小权限账号，只能访问 lyra-media。
LYRA_OBJECT_ACCESS_KEY=
LYRA_OBJECT_SECRET_KEY=

# ---- Milvus v2 可重建投影端口 ----
# Compose 默认只做连接探针。只有显式开启向量检索并完整配置 Embedding 后，
# 持久化 reconciliation/index job 才会运行，并可能创建/更新投影、产生 Embedding 费用。
MILVUS_COLLECTION_V2=lyra_asset_vectors_v2

# ---- 对外端口（浏览器访问 http://localhost:<LYRA_PORT>）----
LYRA_PORT=8788

# ---- 镜像版本（默认跟随 latest；可固定到具体版本，例如 v0.2.0）----
LYRA_TAG=latest

# ---- 镜像源（可选）----
# 默认从 Docker Hub / GHCR 拉取。网络受限时可换成公开镜像源的等价标签：
# LYRA_POSTGRES_IMAGE=public.ecr.aws/docker/library/postgres:17-alpine
# LYRA_REDIS_IMAGE=redis:7.4-alpine
# LYRA_MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
# LYRA_MINIO_CLIENT_IMAGE=minio/mc:RELEASE.2025-04-16T18-13-26Z
# LYRA_ETCD_IMAGE=quay.io/coreos/etcd:v3.5.18
# LYRA_MILVUS_IMAGE=milvusdb/milvus:v2.6.5

# ---- 模型（可选：也可启动后在页面里配置）----
LLM_BASE_URL=
LLM_API_KEY=
LLM_DEFAULT_MODEL=deepseek-v4.1-flash-1017
LLM_REASONING_EFFORT=model-default
LLM_MAX_OUTPUT_TOKENS=8192
LLM_TIMEOUT_MS=180000
LLM_MAX_CONCURRENT_CALLS=2

# 每个选中镜头在调用通用多模态模型前预留 2 元运行预算；设为 0 关闭。
Lyra_FRAME_ASSESSMENT=1

# 供应商媒体 URL 默认仅公网；仅在可信内网 CDN 场景开启。
MEDIA_ALLOW_INTRANET_SOURCES=false

# 语义资产检索（可选）：默认关闭且不产生 Embedding 费用，业务仍走确定性词法检索。
# Milvus 容器健康不改变这个开关。启用前必须同时配置 Embedding，并完成费用授权、
# 预算、投影/回填流程和租户隔离验收；三个 Embedding 字段缺任何一项都不应开启。
ASSET_VECTOR_ENABLED=0
ASSET_EMBEDDING_ENDPOINT=
ASSET_EMBEDDING_MODEL=
ASSET_EMBEDDING_API_KEY=
