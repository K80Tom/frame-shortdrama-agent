# Checksums and scripts assume LF. Force LF on checkout so Windows
# core.autocrlf cannot rewrite SQL (or the sources that hash it).
*.sql text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.swift text eol=lf
*.plist text eol=lf
*.example text eol=lf

*.png binary
*.gif binary
*.mp4 binary
