  "fields": [
    { "path": "novel_sources.raw_text", "owner": "novel", "sensitivity": "confidential", "eventForm": "id+contentSha256" },
    { "path": "script_versions.raw_text", "owner": "script", "sensitivity": "confidential", "eventForm": "id+contentSha256" },
    { "path": "*.sourceRefs[].quote", "owner": "script", "sensitivity": "confidential", "eventForm": "forbidden" },
    { "path": "plan_revisions.content_json", "owner": "script", "sensitivity": "confidential", "eventForm": "revisionId+digest" },
    { "path": "storyboard_revisions.content_json", "owner": "script", "sensitivity": "confidential", "eventForm": "revisionId+digest" },
    { "path": "asset_media.content", "owner": "asset", "sensitivity": "confidential", "eventForm": "assetId+sha256+mimeType+bytes" },
    { "path": "desktop_asset_jobs.task_json", "owner": "asset", "sensitivity": "confidential", "eventForm": "taskId+status+candidateId" },
    { "path": "asset_generation_candidates.provenance_json.promptSnapshot", "owner": "asset", "sensitivity": "confidential", "eventForm": "forbidden" },
    { "path": "model_calls.response_json", "owner": "external", "sensitivity": "confidential", "eventForm": "safeError+usage+resultDigest" },
    { "path": "modelConnections.*.apiKey", "owner": "external", "sensitivity": "secret", "eventForm": "forbidden" },
    { "path": "production_runs.run_json.tasks", "owner": "production", "sensitivity": "internal", "eventForm": "id+version+status+timestamps" },
    { "path": "production_runs.run_json.externalOperations", "owner": "external", "sensitivity": "confidential", "eventForm": "operationKey+status+costBasis" },
    { "path": "production_runs.run_json.qualityChecks", "owner": "quality", "sensitivity": "confidential", "eventForm": "id+result+method+ruleVersion+scope" },
    { "path": "production_runs.run_json.reviews", "owner": "quality", "sensitivity": "confidential", "eventForm": "decision+targetId+createdAt" },
    { "path": "production_runs.run_json.artifacts", "owner": "delivery", "sensitivity": "confidential", "eventForm": "artifactId+mediaId+sha256+status" },
    { "path": "production_runs.run_json.budgetLedger", "owner": "cost", "sensitivity": "confidential", "eventForm": "kind+amountMicros+currency+basis" },
    { "path": "evolution_evidence.evidence_json", "owner": "evaluation", "sensitivity": "confidential", "eventForm": "evidenceId+runDigest" },
    { "path": "evolution_probes.probe_json", "owner": "evaluation", "sensitivity": "confidential", "eventForm": "probeId+fixtureVersion+verdict+safeMetrics" },
    { "path": "evaluation_dataset_revisions.authorization_json", "owner": "evaluation", "sensitivity": "confidential", "eventForm": "authorizationStatus+expiresAt" },
    { "path": "evaluation_cases.input_json/expectation_json", "owner": "evaluation", "sensitivity": "confidential", "eventForm": "caseId+inputDigest+contentDigest" },
    { "path": "evaluation_rubric_revisions.missing_result_policy", "owner": "evaluation", "sensitivity": "internal", "eventForm": "uncertain+skipped+evaluator_error" },
    { "path": "evaluation_rubric_dimensions.scale_json/thresholds_json/evidence_json", "owner": "evaluation", "sensitivity": "confidential", "eventForm": "dimensionKey+label" }
  ],
  "metrics": [
    {
      "id": "lyra.production.run_count.v1",
      "owner": "production",
      "sourceFact": "production.run",
      "aggregation": "countDistinct",
      "groupBy": ["status"],
      "unknownRule": "missingStatus=unknown"
    },
    {
      "id": "lyra.production.task_count.v1",
      "owner": "production",
      "sourceFact": "production.task",
      "aggregation": "countDistinct(runId+taskId)",
      "groupBy": ["status", "stage"],
      "unknownRule": "invalidatedAndSupersededSeparate"
    },
    {
      "id": "lyra.production.external_unknown_count.v1",
      "owner": "external",
      "sourceFact": "external.production_operation",
      "aggregation": "countWhere(status=unknown)",
      "groupBy": ["provider"],
      "unknownRule": "neverCountAsFailure"
    },
    {
      "id": "lyra.delivery.ready_count.v1",
      "owner": "delivery",
      "sourceFact": "delivery.delivery",
      "aggregation": "countWhere(status=ready AND verifiedAt IS NOT NULL AND artifactValid)",
      "groupBy": ["spec.ratio", "spec.container"],
      "unknownRule": "invalidArtifactExcludedAndReported"
    },
    {
      "id": "lyra.quality.check_count.v1",
      "owner": "quality",
      "sourceFact": "quality.production_check",
      "aggregation": "countDistinct(checkId)",
      "groupBy": ["level", "result", "ruleVersion", "method"],
      "unknownRule": "technicalAndSemanticSeparate"
    },
    {
      "id": "lyra.cost.charge_micros.v1",
      "owner": "cost",
      "sourceFact": "cost.budget_entry",
      "aggregation": "sumWhere(kind=charge)",
      "groupBy": ["runId", "currency", "basis"],
      "unknownRule": "missingCurrencyOrBasis=unknownNotZero"
    },
    {
      "id": "lyra.cost.budget_debit_micros.v1",
      "owner": "cost",
      "sourceFact": "cost.budget_entry",
      "aggregation": "sum(charge)+sum(unreleasedReserve)",
      "groupBy": ["runId", "currency"],
      "unknownRule": "notSupplierInvoice"
    },
    {
      "id": "lyra.evaluation.probe_case_count.v1",
      "owner": "evaluation",
      "sourceFact": "evaluation.probe",
      "aggregation": "countCases",
      "groupBy": ["fixtureVersion", "verdict"],
      "unknownRule": "offlineProbeOnly"
    }
  ],
  "requiredConsumers": ["#49", "#50", "#51", "#52", "#53", "#54", "#55"],
  "consumerRule": "后续设计与 PR 必须引用 lyra-data-governance/1；偏离前先修订 ADR、矩阵和目录。"
}
