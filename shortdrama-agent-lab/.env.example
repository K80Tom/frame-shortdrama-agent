# Initial server-only text settings. Existing outputs/private/model-connections.json takes precedence.
# After startup, manage breakdown / image / video / general independently at #/settings/models.
# Never commit the private connection file or put keys in VITE_ variables.
PORT=8788
LLM_BASE_URL=
LLM_API_KEY=
LLM_DEFAULT_MODEL=deepseek-v4.1-flash-1017
# Uses the service default; no reasoning_effort parameter is sent.
LLM_REASONING_EFFORT=model-default
LLM_MAX_OUTPUT_TOKENS=8192
LLM_TIMEOUT_MS=180000
LLM_MAX_CONCURRENT_CALLS=2

# Provider media URLs are public-only by default. Enable only when a trusted
# provider CDN resolves to private network addresses; localhost and link-local remain blocked.
MEDIA_ALLOW_INTRANET_SOURCES=false

# Compose-stage frame assessment uses the configured general multimodal model and may incur cost.
# Set to 0 to disable it and fall back to automatic editing without visual assessment directives.
OHAO_FRAME_ASSESSMENT=1

# Local Docker PostgreSQL. Run npm run db:setup to fill the two empty secrets.
# Setup preserves existing LLM settings. Never copy .env into web/ or commit it.
POSTGRES_USER=shortdrama
POSTGRES_DB=shortdrama_agent
POSTGRES_PORT=5432
POSTGRES_PASSWORD=
DATABASE_URL=
# Docker Hub unavailable? Docker Official Images are also distributed via ECR:
# POSTGRES_IMAGE=public.ecr.aws/docker/library/postgres:17-alpine
